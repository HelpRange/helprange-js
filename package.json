{
  "name": "helprange",
  "version": "0.1.1",
  "description": "Official HelpRange API client for Node.js and TypeScript: upload documents, create tracked share links, run data rooms, e-signature, offers and analytics.",
  "license": "MIT",
  "author": "HelpRange <hello@helprange.com> (https://www.helprange.com)",
  "homepage": "https://www.helprange.com/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelpRange/helprange-js.git"
  },
  "bugs": {
    "url": "https://github.com/HelpRange/helprange-js/issues"
  },
  "keywords": ["helprange", "api", "sdk", "document-sharing", "data-room", "virtual-data-room", "e-signature", "document-analytics", "webhooks"],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/fix-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "test": "npm run build && node --test test/client.test.mjs test/resources.test.mjs test/idempotency.test.mjs test/webhooks.test.mjs test/cjs.test.cjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
